# Database — defaults to local SQLite, swap for Postgres/Supabase URL in production
DATABASE_URL=sqlite:///./oceanmind.db

# Groq LLM (free tier) — https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
CHAT_MODEL=llama-3.3-70b-versatile
CLASSIFIER_MODEL=llama-3.1-8b-instant

# ChromaDB persistence directory
CHROMA_PERSIST_DIR=./chroma_data

# ARGO data source (Indian Ocean bounding box)
ARGO_BASE_URL=https://erddap.ifremer.fr/erddap/tabledap/ArgoFloats
ARGO_LAT_MIN=0
ARGO_LAT_MAX=25
ARGO_LON_MIN=60
ARGO_LON_MAX=100
ARGO_SYNC_DAYS=90

# App
SECRET_KEY=change_me_in_production
FRONTEND_ORIGIN=http://localhost:3000

# Anomaly detection thresholds (in standard deviations)
ANOMALY_SIGMA_MEDIUM=2.0
ANOMALY_SIGMA_HIGH=3.0
ANOMALY_RADIUS_KM=50.0
BASELINE_SURFACE_DEPTH_M=15.0
SELF_BASELINE_WINDOW=20
SELF_BASELINE_MIN_READINGS=5
PRESSURE_DROP_RATE_HPA_PER_HR=1.0

# Optional — require this value in the X-API-Key header on POST /api/sensor/ingest.
# Leave blank for local/demo use. Set before deploying publicly.
SENSOR_API_KEY=
